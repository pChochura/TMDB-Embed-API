TMDB_API_KEY=your_tmdb_api_key
# Optional: JSON array for multi-key rotation
# TMDB_API_KEYS=["key1","key2"]
# Optional: server port (defaults to 8787)
# API_PORT=8787

# VideoGetter in-process resolver (runs natively; set base only to override with external upstream)
# ENABLE_VIDEOGETTER_PROVIDER=true
# VIDEOGETTER_API_BASE=internal
# VIDEOGETTER_API_KEY=lakshya9310081539@

# VidCore in-process resolver (runs natively; set base only to override with external upstream)
# ENABLE_VIDCORE_PROVIDER=true
# VIDCORE_RESOLVER_BASE=internal

# Stremio Addon Bridges
# STREMIO_BRIDGE_URLS=http://127.0.0.1:11470
# STREMIO_POLISH_BRIDGE_URLS=http://127.0.0.1:11470

# Auth & Preferences Sync API / PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tmdb_sync
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tmdb_sync
SYNC_JWT_SECRET=filman_sync_secret_key_change_me
# Optional custom persistent host path for PostgreSQL data
# POSTGRES_DATA_DIR=/mnt/postgres-data

